// {{ ansible_managed }}
options {
    listen-on port 53 { 127.0.0.1; {{ mail_server_ip }}; };
    listen-on-v6 port 53 { ::1; };
    directory       "/var/named";
    allow-query     { localhost; {{ mail_dns_allow_query }}; };
    recursion no;
    dnssec-validation auto;
};

zone "{{ mail_domain }}" IN {
    type master;
    file "{{ mail_domain }}.zone";
    allow-update { none; };
};
