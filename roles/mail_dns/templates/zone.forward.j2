; {{ ansible_managed }}
$TTL 3600
@       IN SOA  {{ mail_hostname }}. postmaster.{{ mail_domain }}. (
                {{ ansible_date_time.epoch | default('2026072301') }} ; serial
                3600       ; refresh
                900        ; retry
                604800     ; expire
                86400 )    ; minimum
;
@       IN NS   {{ mail_hostname }}.
@       IN MX   10 {{ mail_hostname }}.
@       IN A    {{ mail_server_ip }}
mail    IN A    {{ mail_server_ip }}
;
; --- deliverability records ---
@                       IN TXT  "{{ mail_spf_record }}"
_dmarc                  IN TXT  "v=DMARC1; p={{ mail_dmarc_policy }}; rua=mailto:{{ mail_dmarc_rua }}; fo=1"
{% if mail_dkim_record %}
{{ mail_dkim_selector }}._domainkey IN TXT "{{ mail_dkim_record }}"
{% endif %}
_mta-sts                IN TXT  "v=STSv1; id={{ ansible_date_time.epoch | default('2026072301') }}"
_smtp._tls              IN TXT  "v=TLSRPTv1; rua=mailto:{{ mail_dmarc_rua }}"
