{
  "uid": "security-overview",
  "title": "Security Overview",
  "tags": ["platform", "security"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {"list": [
    {"name": "DS", "type": "datasource", "query": "prometheus", "hide": 2, "current": {}, "refresh": 1},
    {"name": "DS_LOKI", "type": "datasource", "query": "loki", "hide": 2, "current": {}, "refresh": 1}
  ]},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Currently Banned IPs (all jails)",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS}"},
      "targets": [{"expr": "sum(fail2ban_banned_current)", "refId": "A", "datasource": {"type": "prometheus", "uid": "${DS}"}}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 5}, {"color": "red", "value": 20}]}}}
    },
    {
      "id": 2, "type": "stat", "title": "AIDE Integrity (max changed files)",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS}"},
      "targets": [{"expr": "max(aide_check_changed_files)", "refId": "A", "datasource": {"type": "prometheus", "uid": "${DS}"}}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 3, "type": "stat", "title": "SSH Failed Logins (5m, fleet)",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [{"expr": "sum(count_over_time({job=\"journald\"} |= \"Failed password\" [5m]))", "refId": "A", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}}]
    },
    {
      "id": 4, "type": "stat", "title": "SELinux AVC Denials (1h, fleet)",
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [{"expr": "sum(count_over_time({job=\"journald\"} |~ \"avc:  ?denied\" [1h]))", "refId": "A", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}}]
    },
    {
      "id": 5, "type": "timeseries", "title": "Banned IPs by jail",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "${DS}"},
      "targets": [{"expr": "fail2ban_banned_current", "legendFormat": "{{instance}} / {{jail}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "${DS}"}}]
    },
    {
      "id": 6, "type": "timeseries", "title": "SSH Failed Logins rate by instance",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [{"expr": "sum by (instance) (rate({job=\"journald\"} |= \"Failed password\" [5m]))", "legendFormat": "{{instance}}", "refId": "A", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}}]
    },
    {
      "id": 7, "type": "logs", "title": "Recent security events (auth failures, sudo, AVC)",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 13},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [{"expr": "{job=\"journald\"} |~ \"Failed password|Invalid user|authentication failure|avc:  ?denied|sudo\"", "refId": "A", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}}]
    }
  ]
}
