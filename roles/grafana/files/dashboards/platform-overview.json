{
  "uid": "platform-overview",
  "title": "Platform Overview",
  "tags": [
    "platform"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets Up",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "expr": "count(up == 1)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 13
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Targets Down",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "expr": "count(up == 0) or vector(0)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Edge nginx Up",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "expr": "sum(up{job=\"nginx\", instance=~\".*edge.*\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Web nginx Up",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "expr": "sum(up{job=\"nginx\", instance=~\".*web.*\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "nginx Requests/sec by instance",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "expr": "rate(nginx_http_requests_total[5m])",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Active Connections by instance",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "expr": "nginx_connections_active",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "MariaDB Threads Connected",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected",
          "legendFormat": "data1",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "MariaDB Queries/sec",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "expr": "rate(mysql_global_status_queries[5m])",
          "legendFormat": "data1",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          }
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2,
        "current": {},
        "refresh": 1
      }
    ]
  }
}