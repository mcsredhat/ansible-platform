{
  "uid": "capacity-trends",
  "title": "Capacity & Trends",
  "tags": ["platform", "capacity"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {"from": "now-7d", "to": "now"},
  "templating": {"list": [{"name": "DS", "type": "datasource", "query": "prometheus", "hide": 2, "current": {}, "refresh": 1}]},
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Disk Used % — 7d trend (predicts fill)",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS}"},
      "targets": [{"expr": "100 - ((node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"}) * 100)", "legendFormat": "{{instance}} {{mountpoint}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "${DS}"}}],
      "fieldConfig": {"defaults": {"unit": "percent", "max": 100}}
    },
    {
      "id": 2, "type": "timeseries", "title": "Predicted days until disk full (linear, 24h slope)",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 9},
      "datasource": {"type": "prometheus", "uid": "${DS}"},
      "targets": [{"expr": "(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / -deriv(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"}[24h])) / 86400 > 0", "legendFormat": "{{instance}} {{mountpoint}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "${DS}"}}],
      "fieldConfig": {"defaults": {"unit": "d"}}
    },
    {
      "id": 3, "type": "timeseries", "title": "MariaDB connections vs. max",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
      "datasource": {"type": "prometheus", "uid": "${DS}"},
      "targets": [
        {"expr": "mysql_global_status_threads_connected", "legendFormat": "connected", "refId": "A", "datasource": {"type": "prometheus", "uid": "${DS}"}},
        {"expr": "mysql_global_variables_max_connections", "legendFormat": "max", "refId": "B", "datasource": {"type": "prometheus", "uid": "${DS}"}}
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Memory used % — 7d trend",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18},
      "datasource": {"type": "prometheus", "uid": "${DS}"},
      "targets": [{"expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "legendFormat": "{{instance}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "${DS}"}}],
      "fieldConfig": {"defaults": {"unit": "percent", "max": 100}}
    }
  ]
}
