{
  "uid": "compliance",
  "title": "Compliance (ANSSI)",
  "tags": ["platform", "compliance"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {"from": "now-30d", "to": "now"},
  "templating": {"list": [{"name": "DS", "type": "datasource", "query": "prometheus", "hide": 2, "current": {}, "refresh": 1}]},
  "panels": [
    {
      "id": 1, "type": "gauge", "title": "Compliance Score % (min across fleet)",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS}"},
      "targets": [{"expr": "min(compliance_score_percent)", "refId": "A", "datasource": {"type": "prometheus", "uid": "${DS}"}}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "orange", "value": 80}, {"color": "green", "value": 90}]}}}
    },
    {
      "id": 2, "type": "timeseries", "title": "Compliance Score % by host (30d trend)",
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS}"},
      "targets": [{"expr": "compliance_score_percent", "legendFormat": "{{instance}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "${DS}"}}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}}
    },
    {
      "id": 3, "type": "timeseries", "title": "Failing rules by host",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${DS}"},
      "targets": [{"expr": "compliance_rules_fail", "legendFormat": "{{instance}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "${DS}"}}]
    }
  ]
}
