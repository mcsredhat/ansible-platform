# {{ ansible_managed }}
server {
    listen {{ wp_backend_port }};
    server_name {{ wp_server_name }};
    root  {{ wp_path }};
    index index.php;

    add_header X-Backend "{{ backend_label }}" always;   # blue/green marker (host_var)

    set_real_ip_from {{ subnet }};
    real_ip_header   X-Forwarded-For;

    location = /healthz { default_type text/plain; return 200 "{{ inventory_hostname }} ok\n"; }

    location / { try_files $uri $uri/ /index.php?$args; }

    location ~ \.php$ {
        include /etc/nginx/fastcgi_params;
        fastcgi_pass unix:/run/php-fpm/www.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_X_FORWARDED_PROTO $http_x_forwarded_proto;
        fastcgi_read_timeout 60s;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ { expires 30d; access_log off; }
    location ~ /\.(ht|git) { deny all; }
    location = /xmlrpc.php  { deny all; }
}
